# --- Rust+ sunucu eslesmesi -----------------------------------------------
# Bu dort deger "sentinel pair" komutuyla otomatik doldurulur.
# Elle doldurmak zorunda degilsin.
RUST_SERVER_IP=
RUST_SERVER_PORT=28082
RUST_STEAM_ID=
RUST_PLAYER_TOKEN=

# Sunucuya verdigin ad (panelde ve bildirimlerde gorunur)
RUST_SERVER_LABEL=Ana Sunucu

# --- Bildirim kanallari ----------------------------------------------------
# Discord kanal ayarlari > Entegrasyonlar > Webhook olustur
DISCORD_WEBHOOK_URL=

# ntfy: telefonda sessiz modu delen ucretsiz push.
# Konu adini tahmin edilemez birsey yap - konuyu bilen herkes mesaj gonderebilir.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# --- Esikler ---------------------------------------------------------------
# Hangi kanal hangi seviyeden itibaren tetiklenir: debug|info|warn|critical
DISCORD_MIN_SEVERITY=info
NTFY_MIN_SEVERITY=warn

# --- Telefon aramasi (opsiyonel) -------------------------------------------
# Bos birakirsan arama kapali kalir, Discord ve ntfy calismaya devam eder.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# DIKKAT: Twilio'nun desteklenen ses tablosunda Turkce (tr-TR) gorunmuyor.
# 'sentinel test-call' ile dogrula. Ses gelmezse:
#   TWILIO_LANGUAGE=en-US
#   TWILIO_VOICE=Polly.Joanna
TWILIO_LANGUAGE=tr-TR
TWILIO_VOICE=Polly.Filiz

# Sirayla aranacak kisiler. Ilk cevap veren zinciri durdurur.
ESCALATION_CONTACTS=Halit:+905000000000,Ahmet:+905000000001

# Aylik arama tavani (USD). Turkiye mobiline dakikasi ~0,29 USD.
# 5 USD ~ 17 dakika. 0 yazarsan sinirsiz olur - onerilmez.
MONTHLY_CALL_BUDGET_USD=5

# Ayni bolge icin iki telefon zinciri arasinda beklenecek sure (saniye)
CALL_COOLDOWN_SECONDS=900

# Telefonun calmasi icin gereken en dusuk tehdit: low|medium|high
# high = tek bir C4/roket patlamasi veya guclu coklu kanit
PHONE_MIN_THREAT=high

# Sessiz saatlerde cita yukselir: gece yalnizca YUKSEK tehdit telefon
# caldirir. Bos birakilirsa kapali.
QUIET_HOURS=

# --- Sistem ----------------------------------------------------------------
DB_PATH=data/sentinel.db
LOG_LEVEL=INFO
HTTP_HOST=127.0.0.1
HTTP_PORT=8787

# Baglanti saglik kontrolu araligi (saniye). Sessiz ariza koruması.
HEALTHCHECK_INTERVAL=1800
